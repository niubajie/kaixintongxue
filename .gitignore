# 仓库收录前端四端与管理后台（TypeScript），以及 Go 服务端
# 旧 Python 服务端与旧 WPF 工程保留在本地
/src/KaixinAssistant/
/src/kaixin_server_py/
/tools/
/.legacy-git/

# Go 服务端运行数据与可执行文件
/src/kaixin_server_go/server-data/
/src/kaixin_server_go/*.exe
/src/kaixin_local_go/*.exe

# 前端依赖与构建产物
node_modules/
dist/

# Tauri / Rust 构建产物
src/kaixin_desktop/src-tauri/target/
src/kaixin_desktop/src-tauri/gen/

# Tauri sidecar 二进制（由 src/kaixin_local_go 编译生成，不入库）
src/kaixin_desktop/src-tauri/binaries/

# .NET 构建产物
bin/
obj/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 本地运行数据与日志
*.log
*.log.*
run_out.txt
crash.out
crash.err
app-run.log*

# 临时与测试产物
cookies.txt
*.zip
install.json
mini-req.json
pkg-test-*.zip

# 截图与工具临时输出
.screenshots/
screenshots/

# IDE / 会话
.trae/
.vscode/
.idea/

# 环境与密钥
.env
.env.*
*.db
*.db-shm
*.db-wal

# 旧工程历史备份
.legacy-git/

# ---- 构建产物（由 fix 脚本追加）----
vite.config.js
vite.config.d.ts
*.tsbuildinfo

