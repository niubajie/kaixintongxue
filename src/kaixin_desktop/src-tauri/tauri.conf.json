{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "开心同学 AI 助手",
  "version": "0.5.0",
  "identifier": "com.kaixin.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "开心同学 AI 助手",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
