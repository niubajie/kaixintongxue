---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" path="/404">
  <div class="page-head">
    <div class="wrap">
      <h1>页面不存在</h1>
      <p>你访问的地址可能已经变了。</p>
    </div>
  </div>

  <div class="prose">
    <div class="wrap">
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">回到首页</a>
        <a class="btn btn-ghost" href="/download">去下载</a>
      </div>
    </div>
  </div>
</BaseLayout>
