---
import "../styles/global.css";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description = SITE.description, path = "/" } = Astro.props;

const nav = [
  { href: "/", label: "首页" },
  { href: "/download", label: "下载" },
  { href: "/changelog", label: "更新日志" },
  { href: "/faq", label: "常见问题" }
];

const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, SITE.url).toString()} />
    <meta property="og:title" content={`${title} · ${SITE.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-mark">开</span>
          <span>{SITE.name}</span>
        </a>
        <nav class="nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
          <a class="btn btn-primary" href="/download">下载 Windows 版</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <div class="brand" style="margin-bottom:8px">
              <span class="brand-mark">开</span>
              <span>{SITE.name}</span>
            </div>
            <p style="margin:0;max-width:34ch">{SITE.tagline}</p>
          </div>
          <div>
            <h4>产品</h4>
            <div class="footer-links">
              <a href="/download">下载</a>
              <a href="/changelog">更新日志</a>
              <a href="/faq">常见问题</a>
            </div>
          </div>
          <div>
            <h4>条款</h4>
            <div class="footer-links">
              <a href="/privacy">隐私政策</a>
              <a href="/terms">用户协议</a>
              {SITE.contactEmail && <a href={`mailto:${SITE.contactEmail}`}>联系我们</a>}
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {SITE.copyrightFrom}–{year} {SITE.name}</span>
          <span>
            {SITE.icp ? (
              <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer noopener">
                {SITE.icp}
              </a>
            ) : (
              <span>ICP 备案号备案中</span>
            )}
            {SITE.police && <span> · {SITE.police}</span>}
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
